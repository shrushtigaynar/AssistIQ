# Copy to server/.env and replace every placeholder.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB is required (Atlas or any MongoDB deployment).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/assistiq?retryWrites=true&w=majority
MONGODB_REQUIRED=true

# Secret used to encrypt stored Gmail OAuth tokens (min 32 chars in production).
ENCRYPTION_SECRET=

# Google Cloud OAuth credentials for the Gmail integration.
# Create an OAuth 2.0 Client ID (Web application) at https://console.cloud.google.com/apis/credentials
# and add the redirect URI below under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/email-accounts/google/callback

# Optional backend-only Gemini configuration for real AI classification.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
AI_CONFIDENCE_THRESHOLD=0.75
