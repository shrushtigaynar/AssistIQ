# Copy to server/.env and replace every placeholder.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas is required. Startup fails if the URI is missing or unreachable.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/assistiq?retryWrites=true&w=majority
MONGODB_REQUIRED=true

# Keep role-specific values private and use separate high-entropy tokens.
ASSISTANT_PORTAL_TOKEN=
CLIENT_PORTAL_TOKEN=
ASSISTANT_EMAIL=assistant@example.com
ASSISTANT_NAME=AssistIQ Assistant
CLIENT_EMAIL=client@example.com
CLIENT_NAME=AssistIQ Client

# Keep disabled unless intentionally resetting a development demo dataset.
ENABLE_DEMO_RESET=false

# Optional backend-only Gemini configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=15000
AI_CONFIDENCE_THRESHOLD=0.75
